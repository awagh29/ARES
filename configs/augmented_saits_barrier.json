{
  "seed": 42,
  "device": "cuda",
  "amp": true,
  "train_fraction": 0.7,
  "val_fraction": 0.15,
  "calibration_fraction_of_train": 0.2,
  "model": {
    "window_size": 50,
    "d_model": 64,
    "n_heads": 4,
    "d_ff": 128,
    "temporal_layers": 1,
    "state_layers": 2,
    "dropout": 0.1
  },
  "pretrain_epochs": 120,
  "pretrain_batch_size": 128,
  "pretrain_learning_rate": 0.001,
  "finetune_epochs": 30,
  "rollout_batch_size": 8,
  "rollout_steps": 200,
  "evaluation_steps": 600,
  "gradient_horizon": 10,
  "control_dt": 0.1,
  "plant_dt": 0.001,
  "finetune_learning_rate": 0.0001,
  "barrier_learning_rate": 0.0001,
  "weight_decay": 0.0001,
  "patience": 20,
  "clip_grad_norm": 1.0,
  "observed_reconstruction_weight": 0.1,
  "auxiliary_reconstruction_weight": 0.1,
  "tracking_weight": 0.1,
  "control_correction_weight": 0.05,
  "barrier_violation_weight": 1.0,
  "geometry_violation_weight": 5.0,
  "tracking_slack_weight": 0.01,
  "reconstruction_weight": 1.0,
  "uncertainty_quantile": 1.0,
  "uncertainty_margin_m": 0.1,
  "minimum_range_bound_m": 0.05,
  "reference_speed_mps": 2.5,
  "tracking_tube_radius_m": 2.5,
  "maximum_yaw_rate_radps": 0.5,
  "nominal_position_gain": 2.0,
  "nominal_velocity_gain": 2.5,
  "nominal_repulsion_gain": 0.2,
  "compile_dynamics": true,
  "checkpoint_every": 1,
  "log_every": 1
}
